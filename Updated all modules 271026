
spec:
  inputs:
    target_branch:
      type: string
      default: "sit_oct"
      description: "Application code branch to build and deploy"

    deploy_env:
      type: string
      default: "sit"
      options:
        - "dev"
        - "dev1"
        - "devnext"
        - "sit"
        - "sit1"
        - "uat"
        - "uat1"
        - "uat2"
        - "preprod"
        - "STG2"
        - "RTAB"
      description: "Target non-production environment"

    deploy_sl:
      type: boolean
      default: true
      description: "Run Staff Loan (SL)"

    deploy_xp:
      type: boolean
      default: false
      description: "Run Xpress (XP)"

---

stages:
  - validate
  - trigger

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "web"'
    - when: never

variables:
  CTRL_TARGET_BRANCH: "$[[ inputs.target_branch ]]"
  CTRL_DEPLOY_ENV: "$[[ inputs.deploy_env ]]"
  CTRL_DEPLOY_SL: "$[[ inputs.deploy_sl ]]"
  CTRL_DEPLOY_XP: "$[[ inputs.deploy_xp ]]"

validate_parameters:
  stage: validate
  tags:
    - rlms_shell_01
  script:
    - |
      set -eu

      echo "========================================"
      echo "RLMS NON-PRODUCTION DEPLOYMENT"
      echo "Controller branch : ${CI_COMMIT_REF_NAME}"
      echo "Application branch: ${CTRL_TARGET_BRANCH}"
      echo "Environment       : ${CTRL_DEPLOY_ENV}"
      echo "Deploy SL         : ${CTRL_DEPLOY_SL}"
      echo "Deploy XP         : ${CTRL_DEPLOY_XP}"
      echo "========================================"

      case "${CTRL_DEPLOY_ENV}" in
        dev|dev1|devnext|sit|sit1|uat|uat1|uat2|preprod|STG2|RTAB)
          ;;
        *)
          echo "ERROR: Invalid or unsupported environment."
          exit 1
          ;;
      esac

      if [ -z "${CTRL_TARGET_BRANCH}" ]; then
        echo "ERROR: Application branch cannot be empty."
        exit 1
      fi

      if [ "${CTRL_DEPLOY_SL}" != "true" ] &&
         [ "${CTRL_DEPLOY_XP}" != "true" ]; then
        echo "ERROR: Select at least one module."
        exit 1
      fi

      echo "Validation successful."

trigger_sl:
  stage: trigger
  tags:
    - rlms_shell_01
  needs:
    - validate_parameters
  rules:
    - if: '$CTRL_DEPLOY_SL == "true"'
      when: on_success
    - when: never
  trigger:
    project: "rlms/source/nxt/staff-loan/rlms-sl-parent"
    branch: "devopstest"
    strategy: mirror
  variables:
    Target_Branch: "$CTRL_TARGET_BRANCH"
    DEPLOY_ENV: "$CTRL_DEPLOY_ENV"

trigger_xp:
  stage: trigger
  tags:
    - rlms_shell_01
  needs:
    - validate_parameters
  rules:
    - if: '$CTRL_DEPLOY_XP == "true"'
      when: on_success
    - when: never
  trigger:
    project: "rlms/source/nxt/xpress/rlms-xp-parent"
    branch: "devopstest"
    strategy: mirror
  variables:
    Target_Branch: "$CTRL_TARGET_BRANCH"
    DEPLOY_ENV: "$CTRL_DEPLOY_ENV"
