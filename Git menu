stages:
  - validate
  - trigger


# ============================================================
# PIPELINE PARAMETERS
# ============================================================

variables:

  Target_Branch:
    value: "devopsTest"
    description: "Branch to build/deploy"

  DEPLOY_ENV:
    value: "sit"
    description: "Environment to deploy"
    options:
      - "dev"
      - "devnext"
      - "sit"
      - "sit1"
      - "uat"
      - "preprod"
      - "prod"

  MODULES:
    value: "all"
    description: "Module to deploy. Use all or one module"
    options:
      - "all"
      - "home-loan"
      - "auto-loan"
      - "commons"
      - "external"
      - "gp"
      - "rt"
      - "sl"
      - "xp"

  AUTO_DEPLOY:
    value: "no"
    description: "Automatically deploy selected environment"
    options:
      - "no"
      - "yes"


# ============================================================
# VALIDATION
# ============================================================

validate_parameters:
  stage: validate

  script:
    - echo "======================================"
    - echo "RLMS UNIVERSAL DEPLOYMENT"
    - echo "======================================"
    - echo "Branch       : $Target_Branch"
    - echo "Environment  : $DEPLOY_ENV"
    - echo "Modules      : $MODULES"
    - echo "Auto Deploy  : $AUTO_DEPLOY"
    - echo "======================================"

    - |
      if [ "$DEPLOY_ENV" = "prod" ] && [ "$AUTO_DEPLOY" = "yes" ]; then
        echo "ERROR: Automatic PROD deployment is not allowed."
        exit 1
      fi

    - |
      if [ "$DEPLOY_ENV" = "select" ]; then
        echo "ERROR: Please select a deployment environment."
        exit 1
      fi

    - |
      if [ -z "$Target_Branch" ]; then
        echo "ERROR: Target_Branch cannot be empty."
        exit 1
      fi

    - echo "Parameter validation successful."


# ============================================================
# HOME LOAN
# ============================================================

deploy_home_loan:
  stage: trigger

  rules:
    - if: '$MODULES == "all" || $MODULES == "home-loan"'
      when: on_success
    - when: never

  trigger:
    project: "rlms/source/nxt/home-loans/home-loan-parent"
    branch: "$Target_Branch"
    strategy: mirror

  variables:
    DEPLOY_ENV: "$DEPLOY_ENV"
    AUTO_DEPLOY: "$AUTO_DEPLOY"


